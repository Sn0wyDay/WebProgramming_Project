# Optional: python run.py works without creating .env.
# SQLite paths are relative to instance/; do not commit that directory.
DATABASE_URL=sqlite:///preview.db
# Leave blank locally to generate a persistent instance/.secret-key.
SECRET_KEY=
APP_ENV=development
PORT=5001
# MusicBrainz and LRCLIB support anonymous access.
# Optional registered LRCLIB server key; never place it in browser code.
LRCLIB_API_KEY=
# Gemini remains deferred.
GEMINI_API_KEY=
GEMINI_MODEL=
